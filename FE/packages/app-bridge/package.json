{
  "name": "@eeos/app-bridge",
  "version": "1.0.0",
  "description": "WebView Bridge for EEOS Native and Web apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": ["webview", "bridge", "react-native"],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@webview-bridge/react-native": "^1.7.8",
    "@webview-bridge/web": "^1.7.8"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}